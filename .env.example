# Variables para el despliegue en Coolify (Docker Compose).
# Copiar a .env solo para pruebas locales de Docker; en Coolify se definen en el panel.
# NUNCA versionar el .env real con secretos.

# --- PostgreSQL ---
# Superusuario del contenedor: inicializa la BD y ejecuta el healthcheck.
# POSTGRES_ADMIN_USER=postgres          # opcional; default: postgres
POSTGRES_ADMIN_PASSWORD=cambia_esta_password_admin

# Rol de aplicacion (minimo privilegio): es el que usa el backend.
# Usa una password URL-safe (por ejemplo hexadecimal) porque va dentro de DATABASE_URL.
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
# APP_DB_USER=finanzas                  # opcional; default: finanzas
APP_DB_PASSWORD=cambia_esta_password_de_aplicacion
# POSTGRES_DB=finanzas                  # opcional; default: finanzas

# --- Backend ---
# Origen publico del frontend, sin barra final. OBLIGATORIO.
CORS_ORIGIN=https://finanzas.example.com

# Secretos JWT (minimo 32 caracteres, distintos entre si). OBLIGATORIOS.
# Genera con: python -c "import secrets; print(secrets.token_hex(48))"
JWT_ACCESS_SECRET=cambia_este_secreto_de_acceso_por_uno_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_este_secreto_de_refresh_por_uno_largo_y_aleatorio

# --- Opcionales (tienen defaults adecuados en el compose) ---
# LOG_LEVEL=info
# JWT_ACCESS_TTL=900
# JWT_REFRESH_TTL=604800
# FORWARDED_ALLOW_IPS=*

# Activa el usuario y los datos demo al arrancar (idempotente: no sobrescribe si ya existe).
# En produccion real descomenta y cambia a false.
# DEMO_SEED_ENABLED=false

# Guardion destructivo: permite que el seed borre datos existentes.
# NUNCA definir como true en produccion salvo de forma consciente.
# SEED_FORCE=false
