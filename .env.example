# Variables para docker compose (copiar a .env en la raiz del repo)
# NUNCA versionar el .env real con secretos.

# --- PostgreSQL ---
# Admin del contenedor (superusuario): inicializa la BD y el healthcheck. El backend NO lo usa.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=cambia_esta_password_admin
# Rol de aplicacion (minimo privilegio): es el que usa el backend.
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=finanzas
# El puerto solo se publica en loopback (127.0.0.1), no a la red externa.
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info

# --- Frontend (contenedor nginx) ---
WEB_PORT=8080

# Secretos JWT (minimo 32 caracteres, distintos entre si)
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia_este_secreto_de_acceso_por_uno_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_este_secreto_de_refresh_por_uno_largo_y_aleatorio
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
