# Variables para docker compose (copiar a .env en la raiz del repo)
# NUNCA versionar el .env real con secretos.

# --- PostgreSQL ---
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=finanzas
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Secretos JWT (minimo 32 caracteres, distintos entre si)
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia_este_secreto_de_acceso_por_uno_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_este_secreto_de_refresh_por_uno_largo_y_aleatorio
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
