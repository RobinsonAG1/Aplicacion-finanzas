# Variables para el despliegue en Coolify (Docker Compose).
# Copiar a .env solo para pruebas locales de Docker; en Coolify se definen en el panel.
# NUNCA versionar el .env real con secretos.

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=cambia_esta_password_admin
APP_DB_USER=finanzas
APP_DB_PASSWORD=cambia_esta_password_de_aplicacion
POSTGRES_DB=finanzas
CORS_ORIGIN=https://finanzas.example.com
JWT_ACCESS_SECRET=cambia_este_secreto_de_acceso_por_uno_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_este_secreto_de_refresh_por_uno_largo_y_aleatorio
DEMO_SEED_ENABLED=true
