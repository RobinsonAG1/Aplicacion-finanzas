# Entorno de la aplicacion: development | test | production
# Tambien se acepta NODE_ENV por compatibilidad.
APP_ENV=development

# Puerto del servidor HTTP
PORT=4000

# Conexion a PostgreSQL
DATABASE_URL=postgresql://finanzas:finanzas@localhost:5432/finanzas

# Origen permitido para CORS (frontend)
CORS_ORIGIN=http://localhost:5173

# Nivel de logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Secretos JWT (OBLIGATORIO: minimo 32 caracteres, distintos entre si, nunca versionar los reales)
# Genera con: python -c "import secrets; print(secrets.token_hex(48))"
JWT_ACCESS_SECRET=cambia_este_secreto_de_acceso_por_uno_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_este_secreto_de_refresh_por_uno_largo_y_aleatorio

# Tiempos de vida de los tokens en SEGUNDOS (900 = 15 min, 604800 = 7 dias)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Guardion del seed: en produccion el seed aborta y borra datos
# solo si se define SEED_FORCE=true de forma consciente.
# SEED_FORCE=true
