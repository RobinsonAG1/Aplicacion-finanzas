# Entorno de la aplicacion: development | test | production
NODE_ENV=development

# Puerto del servidor HTTP
PORT=4000

# Conexion a PostgreSQL
DATABASE_URL=postgresql://finanzas:finanzas@localhost:5432/finanzas?schema=public

# Origen permitido para CORS (frontend)
CORS_ORIGIN=http://localhost:5173

# Nivel de logs: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Secretos JWT (OBLIGATORIO: minimo 32 caracteres, distintos entre si, nunca versionar los reales)
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia_este_secreto_de_acceso_por_uno_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_este_secreto_de_refresh_por_uno_largo_y_aleatorio

# Tiempos de vida de los tokens en SEGUNDOS (900 = 15 min, 604800 = 7 dias)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Guardián del seed: en produccion (NODE_ENV=production) el seed aborta y borra datos
# solo si se define SEED_FORCE=true de forma consciente. Descomentar para forzar.
# SEED_FORCE=true
